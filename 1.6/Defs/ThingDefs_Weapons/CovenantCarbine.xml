<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="BaseMakeableGun" Name="CovenantCarbine">
		<defName>Cov_Carbine</defName>
		<label>Type 51 Carbine</label>
		<description>The Type-51 Carbine is a Covenant infantry firearm.</description>
		<thingClass>VEF.Weapons.LaserGun</thingClass>
		<graphicData>
			<texPath>Item/Equipment/WeaponRanged/Carbine</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<statBases>
			<WorkToMake>400</WorkToMake>
			<Mass>3.6</Mass>
			<AccuracyTouch>0.50</AccuracyTouch>
			<AccuracyShort>0.80</AccuracyShort>
			<AccuracyMedium>0.75</AccuracyMedium>
			<AccuracyLong>0.70</AccuracyLong>
			<RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
		</statBases>
		<recipeMaker>
			<researchPrerequisite>Covenant_Sangheili</researchPrerequisite>
			<unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
            <recipeUsers Inherit="False">
                <li>CovenantWorkbench</li>
            </recipeUsers>
		</recipeMaker>
		<costList>
			<Steel>100</Steel>
                        <Plasteel>20</Plasteel>
			<ComponentSpacer>2</ComponentSpacer>
		</costList>
		<weaponTags>
			<li>Cov_Carbine</li>
                        <li>Cov_ELowTier</li>
                        <li>Cov_LowTier</li>
		</weaponTags>
		<tradeTags>
			<li>CovenantRanged</li>
		</tradeTags>
		<equippedStatOffsets>
		</equippedStatOffsets>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_CarbineLaser</defaultProjectile>
				<warmupTime>0.8</warmupTime>
				<range>31</range>
				<ticksBetweenBurstShots>20</ticksBetweenBurstShots>
				<burstShotCount>3</burstShotCount>
				<soundCast>Carbine_shot</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>10</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>1.5</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>6</power>
				<cooldownTime>0.9</cooldownTime>
			</li>
		</tools>
	</ThingDef>

	<ThingDef Class="VEF.Weapons.LaserBeamDef" ParentName="CovLaserBeamBase">
		<defName>Bullet_CarbineLaser</defName>
		<label>carbine beam</label>
		<graphicData>
			<texPath>Projectile/carbine_Laser</texPath>
		</graphicData>
		<textures Inherit="False">
			<li>Projectile/CarbineProjectile</li>
		</textures>
		<projectile>
			<flyOverhead>false</flyOverhead>
			<damageDef>Plasma_Damage</damageDef>
			<damageAmountBase>7</damageAmountBase>
			<armorPenetrationBase>0.5</armorPenetrationBase>
			<stoppingPower>0.2</stoppingPower>
			<speed>100</speed>
		</projectile>
	</ThingDef>

</Defs>