<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Spiker -->
  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_SpikerShot</defName>
    <label>spiker Shot</label>
    <graphicData>
		<texPath>Projectile/SpikeProjectile</texPath>
		<graphicClass>Graphic_Single</graphicClass>
    </graphicData>
	<projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>6</damageAmountBase>
      <armorPenetrationBase>0.19</armorPenetrationBase>
	  <stoppingPower>1</stoppingPower>
      <speed>60</speed>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>Spiker</defName>
    <label>Type 25 Carbine</label>
    <description>Fully-automatic, magazine-fed rail type weapon. Jiralhanae in origin.</description>
    <graphicData>
		<texPath>Item/Equipment/WeaponRanged/Spiker</texPath>
		<graphicClass>Graphic_Single</graphicClass>
                <drawSize>1.4</drawSize>
    </graphicData>
	<soundInteract>Interact_Revolver</soundInteract>
    <statBases>
      <WorkToMake>200</WorkToMake>
	  <Mass>3.1</Mass>
	  <AccuracyTouch>0.87</AccuracyTouch>
      <AccuracyShort>0.82</AccuracyShort>
      <AccuracyMedium>0.70</AccuracyMedium>
      <AccuracyLong>0.55</AccuracyLong>
	  <RangedWeapon_Cooldown>1.36</RangedWeapon_Cooldown>
    </statBases>
	<costList>
      <Steel>55</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
	<recipeMaker>
		<researchPrerequisite>Covenant_Jiralhanae</researchPrerequisite>
		<skillRequirements>
			<Crafting>5</Crafting>
		</skillRequirements>
                <recipeUsers Inherit="False">
			<li>CovenantWorkbench</li>
		</recipeUsers>
	</recipeMaker>
	<weaponTags>
      <li>Spiker</li>
      <li>Cov_BruteWep</li>
    </weaponTags>
	<equippedAngleOffset>0</equippedAngleOffset>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_SpikerShot</defaultProjectile>
        <warmupTime>0.90</warmupTime>
        <range>26</range>
        <burstShotCount>6</burstShotCount>
        <ticksBetweenBurstShots>9</ticksBetweenBurstShots>
        <soundCast>SpikerShot</soundCast>
		<soundCastTail>GunTail_Medium</soundCastTail>
		<muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
	<tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>1.6</cooldownTime>
      </li>
      <li>
        <label>blade</label>
        <capacities>
          <li>Cut</li>
          <li>Poke</li>
        </capacities>
        <power>8</power>
        <cooldownTime>1.6</cooldownTime>
      </li>
    </tools>
  </ThingDef>
  
</Defs>