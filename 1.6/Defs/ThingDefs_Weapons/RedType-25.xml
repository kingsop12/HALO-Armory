<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="BaseMakeableGun" Name="CovenantRedPlasmaRifle">
		<defName>BrutePlasmaRifle</defName>
		<label>Jiralhanae Type 25 Rifle</label>
		<description>The Type-25 Rifle, also known as the Jiralhanae Type-25 Directed Energy Rifle, is a Jiralhanae infantry firearm. Weaker Damnge but lower cool down and faster fire rate.</description>
		<graphicData>
			<texPath>Item/Equipment/WeaponRanged/BrutePlasmaRifle</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Interact_ChargeRifle</soundInteract>
		<statBases>
			<WorkToMake>500</WorkToMake>
			<Mass>2.2</Mass>
			<AccuracyTouch>0.50</AccuracyTouch>
			<AccuracyShort>0.80</AccuracyShort>
			<AccuracyMedium>0.75</AccuracyMedium>
			<AccuracyLong>0.40</AccuracyLong>
			<RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
		</statBases>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_RPlasmaProjectile</defaultProjectile>
				<warmupTime>0.15</warmupTime>
				<range>25</range>
				<ticksBetweenBurstShots>7</ticksBetweenBurstShots>
				<burstShotCount>6</burstShotCount>
				<soundCast>PlasmaRifle_Shot</soundCast>
				<soundCastTail>GunTail_Light</soundCastTail>
				<muzzleFlashScale>7</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
			</li>
		</verbs>
		<tools>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>1.5</cooldownTime>
			</li>
		</tools>
		<weaponTags>
			<li>Red_PlasmaRifle</li>
                        <li>Cov_BruteWep</li>
		</weaponTags>
		<recipeMaker>
			<researchPrerequisite>Covenant_Jiralhanae</researchPrerequisite>
			<unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
            <recipeUsers Inherit="False">
                <li>CovenantWorkbench</li>
            </recipeUsers>
		</recipeMaker>
		<costList>
			<Steel>150</Steel>
			<Plasteel>120</Plasteel>
			<ComponentIndustrial>8</ComponentIndustrial>
		</costList>
	</ThingDef>

	<ThingDef ParentName="BaseBullet">
		<defName>Bullet_RPlasmaProjectile</defName>
		<label>Plasma shot</label>
		<graphicData>
			<texPath>Projectile/ShadeProjectile</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>1.7</drawSize>
		</graphicData>
		<projectile>
			<damageDef>Plasma_Damage</damageDef>
			<damageAmountBase>6</damageAmountBase>
			<armorPenetrationBase>0.13</armorPenetrationBase>
			<stoppingPower>0.2</stoppingPower>
			<speed>90</speed>
		</projectile>
	</ThingDef>

</Defs>