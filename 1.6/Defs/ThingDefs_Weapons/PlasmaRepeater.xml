<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="BaseMakeableGun" Name="PlasmaR">
		<defName>PlasmaRepeater</defName>
		<label>Type 51 Directed Energy Rifle</label>
		<description>Automatic Directed Energy Weapon, capable of inflicting severe burns. Best at close/medium range.</description>
		<graphicData>
			<texPath>Item/Equipment/WeaponRanged/PlasmaRepeater</texPath>
			<graphicClass>Graphic_Single</graphicClass>
                        <drawSize>1.4</drawSize>
		</graphicData>
		<soundInteract>Interact_ChargeRifle</soundInteract>
		<statBases>
			<WorkToMake>500</WorkToMake>
			<Mass>2.2</Mass>
			<AccuracyTouch>0.95</AccuracyTouch>
			<AccuracyShort>0.70</AccuracyShort>
			<AccuracyMedium>0.65</AccuracyMedium>
			<AccuracyLong>0.30</AccuracyLong>
			<RangedWeapon_Cooldown>2.0</RangedWeapon_Cooldown>
		</statBases>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_Plasmar</defaultProjectile>
				<warmupTime>1.0</warmupTime>
				<range>31</range>
				<ticksBetweenBurstShots>8</ticksBetweenBurstShots>
				<burstShotCount>5</burstShotCount>
				<soundCast>Repeater_Shot</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
			</li>
		</verbs>
		<tools>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>1.8</cooldownTime>
			</li>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>10</power>
				<cooldownTime>1.5</cooldownTime>
			</li>
		</tools>
		<weaponTags>
			<li>Cov_Repeater</li>
                        <li>Cov_BruteWep</li>
                        <li>Cov_ELowTier</li>
		</weaponTags>
		<recipeMaker>
			<researchPrerequisite>Covenant_Sangheili</researchPrerequisite>
			<unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
            <recipeUsers Inherit="False">
                <li>CovenantWorkbench</li>
            </recipeUsers>
		</recipeMaker>
		<costList>
			<Steel>250</Steel>
			<Plasteel>130</Plasteel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
	</ThingDef>

	<ThingDef ParentName="BaseBullet">
		<defName>Bullet_Plasmar</defName>
		<label>Plasma shot</label>
		<graphicData>
			<texPath>Projectile/PlasmaProjectile</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>1.7</drawSize>
		</graphicData>
		<projectile>
			<damageDef>Plasma_Damage</damageDef>
			<damageAmountBase>14</damageAmountBase>
			<armorPenetrationBase>0.19</armorPenetrationBase>
			<stoppingPower>0.2</stoppingPower>
			<speed>60</speed>
		</projectile>
	</ThingDef>

</Defs>