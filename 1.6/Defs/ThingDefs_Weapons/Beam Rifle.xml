	<!-- ====================== Laser Sniper Rifle  ===================== -->
	<ThingDef ParentName="VWEL_Bullet_LaserGeneric" Class="VEF.Weapons.LaserBeamDef">
		<defName>Cov_Bullet_BeamRifle</defName>
		<label>precise laser shot</label>
		<description>A focused, long range laser beam.</description>
		<textures>
			<li>Projectile/Beam</li>
		</textures>
		<seam>0.1</seam>
		<causefireChance>0.2</causefireChance>
		<beamWidth>1.5</beamWidth>
		<lifetime>120</lifetime>
		<projectile>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>48</damageAmountBase>
			<armorPenetrationBase>1</armorPenetrationBase>
			<stoppingPower>3</stoppingPower>
		</projectile>
	</ThingDef>
	<ThingDef ParentName="VWE_BaseLaserGunUltra">
		<defName>Beam_Rifle</defName>
		<thingClass>VEF.Weapons.LaserGun</thingClass>
		<label>Type-50 Sniper Rifle</label>
		<description>The Type-50 Sniper Rifle System otherwise known as the Particle Beam Rifle, is a Covenant long-range weapon and the counterpart of the UNSC Sniper Rifle.</description>
		<graphicData>
			<texPath>Item/Equipment/WeaponRanged/BeamSniper</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<statBases>
			<WorkToMake>120500</WorkToMake>
			<MarketValue>3600</MarketValue>
			<Mass>3.8</Mass>
			<AccuracyTouch>0.64</AccuracyTouch>
			<AccuracyShort>0.85</AccuracyShort>
			<AccuracyMedium>0.98</AccuracyMedium>
			<AccuracyLong>1.0</AccuracyLong>
			<RangedWeapon_Cooldown>2.2</RangedWeapon_Cooldown>
		</statBases>
                <recipeMaker>
                  <researchPrerequisite>Covenant_Sangheili</researchPrerequisite>
                  <skillRequirements>
                    <Crafting>9</Crafting>
                  </skillRequirements>
                  <recipeUsers Inherit="False">
			  <li>CovenantWorkbench</li>
                  </recipeUsers>
                </recipeMaker>
		<costList>
			<Steel>65</Steel>
			<Plasteel>70</Plasteel>
			<ComponentSpacer>8</ComponentSpacer>
		</costList>
		<techLevel>Ultra</techLevel>
		<weaponTags Inherit="False">
			<li>Cov_Sniper</li>
                        <li>Cov_HighTier</li>
		</weaponTags>
		<generateCommonality>0.1</generateCommonality>
		<equippedStatOffsets>
			<MoveSpeed>-0.15</MoveSpeed>
			<!-- drawback -->
		</equippedStatOffsets>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<label>Standard</label>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Cov_Bullet_BeamRifle</defaultProjectile>
				<warmupTime>4.6</warmupTime>
				<range>44.9</range>
				<ticksBetweenBurstShots>10</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<soundCast>BeamRifleShot</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
