<?xml version="1.0" encoding="utf-8" ?>
<Defs>
 
    <HediffDef>
        <defName>Cov_Supercombine</defName>
        <label>Molecular Instability</label>
        <description>Disrupted at a molecular level if they die they will explode.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <scenarioCanAdd>false</scenarioCanAdd>
        <maxSeverity>0.90</maxSeverity>
        <isBad>true</isBad>        
        <comps>
<li Class="ModularBullet.HediffCompProperties_ExplodeOnSeverity">
        <severityToExplode>0.30</severityToExplode>
        <damageDef>Bomb</damageDef>
        <damageAmount>20</damageAmount>
        <armorPen>2.0</armorPen>
        <radius>2</radius>
        <isClearHediffOnExplode>true</isClearHediffOnExplode>
      </li>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>100</disappearsAfterTicks>
      </li>
      <li Class="HediffCompProperties_Infecter">
        <infectionChance>0.1</infectionChance>
      </li>
    </comps>
    <injuryProps>
	    <painPerSeverity>0.005</painPerSeverity>
	    <averagePainPerSeverityPermanent>0.0015</averagePainPerSeverityPermanent>
	    <canMerge>true</canMerge>
	    <destroyedLabel>Burned away</destroyedLabel>
	    <destroyedOutLabel>Burned away</destroyedOutLabel>
    </injuryProps>
    </HediffDef>

</Defs>