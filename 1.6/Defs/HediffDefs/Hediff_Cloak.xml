<?xml version="1.0" encoding="utf-8" ?>
<Defs>

      <HediffDef>
        <defName>Cov_Cloaking</defName>
        <label>Cloaking Inplant</label>
        <description>So long as this Pawn is maintaining a distance of 5 they can not been seen.</description>    
    <hediffClass>HediffWithComps</hediffClass>                
        <comps>
            <li Class="ReveMechAbilities.HediffCompProperties_HediffOnCondition">
                <checkInterval>60</checkInterval>
                <hediffDefActive>Elite_Invisibility</hediffDefActive>
                <cooldown>60</cooldown>
                <isRemoveWhenInCombat>true</isRemoveWhenInCombat>
                <isRemoveWhenInPawnProximity>true</isRemoveWhenInPawnProximity>
                <isProximityCountOnlyHostile>true</isProximityCountOnlyHostile>
                <radius>7</radius>
            </li>
        </comps>
        <stages />
    </HediffDef>

	  <!-- Elite -->
  <PawnKindDef Name="Cov_CEliteBase" ParentName="Cov_EliteBase" Abstract="True">
    <label>Sangheili</label>
    <combatPower>30</combatPower>
    <initialResistanceRange>25~44</initialResistanceRange>
    <initialWillRange>25~50</initialWillRange>
    <isFighter>true</isFighter>
    <gearHealthRange>0.6~2</gearHealthRange>
    <apparelMoney>40000~60000</apparelMoney>
    <xenotypeSet>
      <xenotypeChances>
        <Cov_Sangheili>1.0</Cov_Sangheili>
      </xenotypeChances>
    </xenotypeSet>
    <apparelAllowHeadgearChance>0.9</apparelAllowHeadgearChance>
    <techHediffsChance>0.04</techHediffsChance>
    <techHediffsMoney>2200~7000</techHediffsMoney>
    <backstoryCategories>
      <li>Offworld</li>
      <li>Outlander</li>
    </backstoryCategories>
    <apparelTags>
      <li>UndersuitE</li>
    </apparelTags>
    <maxGenerationAge>45</maxGenerationAge>
    <disallowedTraits>
      <li>BodyPurist</li>
      <li>Brawler</li>
    </disallowedTraits>
  </PawnKindDef>

  <HediffDef>
    <defName>Elite_Invisibility</defName>
    <label>Cloak of Elite</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>cloak.</description>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Invisibility">
        <visibleToPlayer>false</visibleToPlayer>
        <fadeDurationTicks>80</fadeDurationTicks>
        <recoverFromDisruptedTicks>120</recoverFromDisruptedTicks>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath"/>
    </comps>
		<stages>
			<li>
                          <becomeVisible>false</becomeVisible>
			</li>
		</stages>
  </HediffDef>

  <PawnKindDef ParentName="Cov_CEliteBase">
    <defName>Cov_InvsElite</defName>
    <label>Steath Elite</label>
    <combatPower>120</combatPower>
    <apparelRequired>
      <li>MajorArmor</li>
      <li>MajorHelm</li>
      <li>Cov_MajorPauldron</li>
    </apparelRequired>
    <maxPerGroup>1</maxPerGroup>
    <isBoss>true</isBoss>
    <weaponMoney>45000~19000</weaponMoney>
    <weaponTags>
      <li>EnergySword</li>
      <li>EnergyDagger</li>
    </weaponTags>
    <techHediffsChance>1</techHediffsChance>
    <techHediffsMoney>9999~9999</techHediffsMoney>
    <skipResistant>false</skipResistant>
    <startingHediffs>
      <li>
        <def>Cov_Cloaking</def>
      </li>
    </startingHediffs>
  </PawnKindDef>


</Defs>
