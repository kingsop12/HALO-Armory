<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- ======================MINOR ARMOR====================== -->

	<ThingDef ParentName="ArmorHelmetMakeableBase">
		<defName>MinorHelm</defName>
		<label>Minor Helmet</label>
		<techLevel>Spacer</techLevel>
		<description>A sleek and sturdy desgined helmet ment to fit the lower ranks of Covenant sangheili forces.</description>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<researchPrerequisite>Covenant_Sangheili</researchPrerequisite>
			<recipeUsers Inherit="False">
				<li>CovenantWorkbench</li>
			</recipeUsers>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
		</recipeMaker>
		<statBases>
			<WorkToMake>2000</WorkToMake>
			<MaxHitPoints>150</MaxHitPoints>
			<Mass>1.8</Mass>
			<Flammability>0.4</Flammability>
			<ArmorRating_Sharp>0.92</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.40</ArmorRating_Blunt>
			<ArmorRating_Heat>0.46</ArmorRating_Heat>
                        <Insulation_Cold>15</Insulation_Cold>
                        <Insulation_Heat>25</Insulation_Heat>
			<EquipDelay>2</EquipDelay>
		</statBases>
		<thingCategories Inherit="False">
			<li>CovenantGear</li>
		</thingCategories>
		<costList>
			<ComponentSpacer>1</ComponentSpacer>
			<Plasteel>25</Plasteel>
			<Uranium>5</Uranium>
		</costList>
		<graphicData>
			<texPath>Apparel/CovenantApparel/Elite/Minor/EliteHelmet1</texPath>
			<graphicClass>Graphic_Single</graphicClass>
                        <shaderType>CutoutComplex</shaderType>
			<drawSize>1.6</drawSize>
		</graphicData>
		<apparel>
			<bodyPartGroups>
				<li>FullHead</li>
			</bodyPartGroups>
			<wornGraphicPath>Apparel/CovenantApparel/Elite/Minor/EliteHelmet1</wornGraphicPath>
                        <useWornGraphicMask>true</useWornGraphicMask>
			<layers>
				<li>Overhead</li>
			</layers>
			<tags>
				<li>SangheiliMinorHelmet</li>
			</tags>
			<defaultOutfitTags>
				<li>SangheiliMinorHelmet</li>
				<li>Soldier</li>
			</defaultOutfitTags>
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
                  <options>
                    <li>
			<only>(57,82,146,255)</only>
                    </li>
                    <li>
			<only>(57,82,146,255)</only>
                    </li>
                  </options>
		</colorGenerator>
		<thingSetMakerTags>
			<li>RewardSpecial</li>
		</thingSetMakerTags>
	</ThingDef>

	<ThingDef ParentName="ArmorMakeableBaseCov">
		<defName>MinorArmor</defName>
		<label>Minor Armor</label>
		<techLevel>Spacer</techLevel>
		<description>Fashioned in blue for the lower ranks of Covenant sangheili forces.</description>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<researchPrerequisite>Covenant_Sangheili</researchPrerequisite>
			<recipeUsers Inherit="False">
				<li>CovenantWorkbench</li>
			</recipeUsers>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
		</recipeMaker>
		<statBases>
			<WorkToMake>4000</WorkToMake>
			<MaxHitPoints>325</MaxHitPoints>
			<Mass>5</Mass>
			<Flammability>0.4</Flammability>
			<ArmorRating_Sharp>1.26</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.63</ArmorRating_Blunt>
			<ArmorRating_Heat>1.08</ArmorRating_Heat>
                        <Insulation_Cold>15</Insulation_Cold>
                        <Insulation_Heat>25</Insulation_Heat>
			<EquipDelay>5</EquipDelay>
		</statBases>
		<thingCategories Inherit="False">
			<li>CovenantGear</li>
		</thingCategories>
		<costList>
			<ComponentSpacer>3</ComponentSpacer>
			<Plasteel>120</Plasteel>
			<Uranium>10</Uranium>
		</costList>
		<graphicData>
			<texPath>Apparel/CovenantApparel/Elite/MinorA/EliteArmor1</texPath>
			<graphicClass>Graphic_Single</graphicClass>
                        <shaderType>CutoutComplex</shaderType>
			<drawSize>1.6</drawSize>
		</graphicData>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
                                <li>Feet</li>
                                <li>Hands</li>
                                <li>Neck</li>
			</bodyPartGroups>
                        <wornGraphicPath>Apparel/CovenantApparel/Elite/MinorA/EliteArmor1</wornGraphicPath>
                        <useWornGraphicMask>true</useWornGraphicMask>
			<layers>
				<li>Middle</li>
			</layers>
			<tags>
				<li>SangheiliMinorArmor</li>
			</tags>
			<defaultOutfitTags>
				<li>SangheiliMinorArmor</li>
                                <li>Soldier</li>
			</defaultOutfitTags>
                        <useDeflectMetalEffect>true</useDeflectMetalEffect>
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
                  <options>
                    <li>
			<only>(57,82,146,255)</only>
                    </li>
                    <li>
			<only>(57,82,146,255)</only>
                    </li>
                  </options>
		</colorGenerator>
                <tickerType>Normal</tickerType>
		<comps>
                  <li Class="VEF.Apparels.CompProperties_ShieldBubble">
                   <compClass>VEF.Apparels.CompShieldBubble</compClass>
                   <blockRangedAttack>true</blockRangedAttack>
                   <blockMeleeAttack>false</blockMeleeAttack>
                   <showWhenDrafted>false</showWhenDrafted>
                   <showOnHostiles>false</showOnHostiles>
                   <showOnNeutralInCombat>false</showOnNeutralInCombat>
                   <shieldTexPath>Other/ShieldBubble</shieldTexPath>
                   <EnergyShieldRechargeRate>0.10</EnergyShieldRechargeRate>
                   <EnergyShieldEnergyMax>70</EnergyShieldEnergyMax>
                   <minShieldSize>1.4</minShieldSize>
                   <maxShieldSize>1.8</maxShieldSize>
                  <disableRotation>true</disableRotation>
                  <chargeFullyWhenMade>true</chargeFullyWhenMade>
                </li>
		</comps>
		<thingSetMakerTags>
		  <li>RewardSpecial</li>
		</thingSetMakerTags>
	
  </ThingDef>


  
<!-- ======================MAJOR ARMOR====================== -->

	<ThingDef ParentName="ArmorHelmetMakeableBase">
		<defName>MajorHelm</defName>
		<label>Major Helmet</label>
		<techLevel>Spacer</techLevel>
		<description>reinforced design of the minor helmet meant to fit the some of the commanding ranks of Covenant sangheili ground forces. This is one piece of a set of armor denoting a warrior's rank and capabilities in combat.</description>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<researchPrerequisite>Covenant_Sangheili</researchPrerequisite>
			<recipeUsers Inherit="False">
				<li>CovenantWorkbench</li>
			</recipeUsers>
			<skillRequirements>
				<Crafting>7</Crafting>
			</skillRequirements>
		</recipeMaker>
		<statBases>
			<WorkToMake>2300</WorkToMake>
			<MaxHitPoints>175</MaxHitPoints>
			<Mass>1.8</Mass>
			<Flammability>0.4</Flammability>
			<ArmorRating_Sharp>0.92</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.40</ArmorRating_Blunt>
			<ArmorRating_Heat>0.46</ArmorRating_Heat>
                        <Insulation_Cold>15</Insulation_Cold>
                        <Insulation_Heat>25</Insulation_Heat>
			<EquipDelay>2</EquipDelay>
		</statBases>
		<thingCategories Inherit="False">
			<li>CovenantGear</li>
		</thingCategories>
		<costList>
			<ComponentSpacer>1</ComponentSpacer>
			<Plasteel>30</Plasteel>
			<Uranium>5</Uranium>
		</costList>
		<graphicData>
			<texPath>Apparel/CovenantApparel/Elite/Major/EliteHelmet2</texPath>
			<graphicClass>Graphic_Single</graphicClass>
                        <shaderType>CutoutComplex</shaderType>
			<drawSize>1.6</drawSize>
		</graphicData>
		<apparel>
			<bodyPartGroups>
				<li>FullHead</li>
			</bodyPartGroups>
			<wornGraphicPath>Apparel/CovenantApparel/Elite/Major/EliteHelmet2</wornGraphicPath>
                        <useWornGraphicMask>true</useWornGraphicMask>
			<layers>
				<li>Overhead</li>
			</layers>
			<tags>
				<li>SangheiliMajorHelmet</li>
			</tags>
			<defaultOutfitTags>
				<li>SangheiliMajorHelmet</li>
				<li>Soldier</li>
			</defaultOutfitTags>
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
                  <options>
                    <li>
			<only>(154,15,15,255)</only>
                    </li>
                    <li>
			<only>(154,15,15,255)</only>
                    </li>
                  </options>
		</colorGenerator>
		<thingSetMakerTags>
			<li>RewardSpecial</li>
		</thingSetMakerTags>
	</ThingDef>

