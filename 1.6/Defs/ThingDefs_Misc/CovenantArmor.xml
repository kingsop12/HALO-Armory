			<tags>
				<li>UnggoyMinorArmor</li>
			</tags>
			<defaultOutfitTags>
				<li>UnggoyMinorArmor</li>
			</defaultOutfitTags>
                        <useDeflectMetalEffect>true</useDeflectMetalEffect>
		</apparel>
                <tickerType>Normal</tickerType>
		<thingSetMakerTags>
		  <li>RewardSpecial</li>
		</thingSetMakerTags>
  </ThingDef>


