<Defs>

<!-- ======================GRUNT MINOR ARMOR====================== -->

	<ThingDef ParentName="ArmorHelmetMakeableBase">
		<defName>GruntMask</defName>
		<label>Grunt Mask</label>
		<techLevel>Spacer</techLevel>
		<description>A Mask used by the Unggoy Race.</description>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<researchPrerequisite>Covenant_Lesser</researchPrerequisite>
			<recipeUsers Inherit="False">
				<li>CovenantWorkbench</li>
			</recipeUsers>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
		</recipeMaker>
		<statBases>
			<WorkToMake>2200</WorkToMake>
			<MaxHitPoints>150</MaxHitPoints>
			<Mass>1.8</Mass>
			<Flammability>0.4</Flammability>
			<ArmorRating_Sharp>0.20</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.10</ArmorRating_Blunt>
			<ArmorRating_Heat>0.40</ArmorRating_Heat>
                        <Insulation_Cold>15</Insulation_Cold>
                        <Insulation_Heat>25</Insulation_Heat>
			<EquipDelay>2</EquipDelay>
		</statBases>
		<thingCategories Inherit="False">
			<li>CovenantGear</li>
		</thingCategories>
		<costList>
			<Plasteel>25</Plasteel>
			<Uranium>5</Uranium>
		</costList>
		<graphicData>
			<texPath>Apparel/CovenantApparel/Grunt/GruntMH/GruntHelmet</texPath>
			<graphicClass>Graphic_Single</graphicClass>
                        <shaderType>CutoutComplex</shaderType>
			<drawSize>1.6</drawSize>
		</graphicData>
		<apparel>
			<bodyPartGroups>
				<li>FullHead</li>
			</bodyPartGroups>
			<wornGraphicPath>Apparel/CovenantApparel/Grunt/GruntMH/GruntHelmet</wornGraphicPath>
                        <useWornGraphicMask>true</useWornGraphicMask>
			<layers>
				<li>Overhead</li>
			</layers>
			<tags>
				<li>UnggoyMask</li>
			</tags>
			<defaultOutfitTags>
				<li>UnggoyMask</li>
			</defaultOutfitTags>
		</apparel>
		<thingSetMakerTags>
			<li>RewardSpecial</li>
		</thingSetMakerTags>
	</ThingDef>

